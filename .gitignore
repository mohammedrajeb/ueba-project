# =========================
# Data files
# =========================

data/raw/*
data/processed/*
data/alerts/*

!data/raw/.gitkeep
!data/raw/README.md
!data/processed/.gitkeep
!data/alerts/.gitkeep

# Allow final exported UEBA outputs
!data/processed/ueba_features.csv
!data/alerts/alerts.csv

# =========================
# Models
# =========================

models/*
!models/.gitkeep

# Allow trained UEBA model artifacts
!models/isolation_forest_model.pkl
!models/isolation_forest_scaler.pkl
!models/autoencoder_model.keras
!models/autoencoder_scaler.pkl
!models/model_metadata.json

# =========================
# Reports
# =========================

# Allow analytical tables generated by notebooks
!reports/tables/
!reports/tables/*.csv

# =========================
# Large files
# =========================

*.tar
*.tar.bz2
*.zip

# Keep generic generated files ignored, except explicit exceptions above
*.pkl
*.h5
*.keras

# Ignore CSV files by default, except explicit exceptions above
*.csv

# Re-allow selected CSV outputs after the global *.csv rule
!data/processed/ueba_features.csv
!data/alerts/alerts.csv
!reports/tables/*.csv

# Re-allow selected model outputs after the global model rules
!models/isolation_forest_model.pkl
!models/isolation_forest_scaler.pkl
!models/autoencoder_model.keras
!models/autoencoder_scaler.pkl

# =========================
# Python
# =========================

__pycache__/
*.pyc

# =========================
# Jupyter
# =========================

.ipynb_checkpoints/

# =========================
# Environment variables
# =========================

.env

# =========================
# System files
# =========================

.DS_Store
Thumbs.db